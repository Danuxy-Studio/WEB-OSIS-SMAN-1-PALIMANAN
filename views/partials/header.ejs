        }

        .event-detail-full ul li {
            justify-content: center;
        }

        .event-detail-full .btn-doc {
            font-size: 0.75rem;
            padding: 6px 12px;
        }

        .stat-card-alt-grid {
            grid-template-columns: 1fr !important;
            gap: 10px !important;
        }

        /* Footer */
        .footer-grid {
            grid-template-columns: 1fr;
            gap: 16px;
            padding-bottom: 16px;
        }

        .footer-professional {
            padding: 20px 0 0;
        }

        .footer-col {
            text-align: center;
        }

        .footer-col h4 {
            justify-content: center;
            font-size: 0.85rem;
        }

        .footer-description {
            text-align: center !important;
            margin: 0 auto !important;
        }

        .footer-links a {
            justify-content: center;
            font-size: 0.75rem;
            padding: 4px 0;
        }

        .footer-contact li {
            justify-content: center;
            font-size: 0.75rem;
        }

        .footer-badges {
            justify-content: center;
        }

        .footer-social {
            align-items: center;
        }

        .social-link {
            justify-content: center;
            width: 100%;
            max-width: 220px;
            font-size: 0.75rem;
            padding: 6px 12px;
            margin-left: 0;
        }

        .footer-bottom {
            flex-direction: column !important;
            text-align: center !important;
            padding: 12px 0 16px !important;
            gap: 4px !important;
            flex-wrap: wrap !important;
        }

        .footer-bottom p {
            font-size: 0.6rem !important;
            white-space: normal !important;
            text-align: center !important;
            width: 100% !important;
        }

        .footer-copyright,
        .footer-credit {
            text-align: center !important;
        }

        .footer-logo img {
            height: 40px !important;
        }

        .badge-active {
            font-size: 0.6rem;
            padding: 2px 10px;
        }

        .logo-link img {
            height: 40px;
        }
    }

    /* --- Layar sedang (tablet) --- */
    @media (min-width: 641px) and (max-width: 1023px) {
        .stats-grid {
            grid-template-columns: repeat(4, 1fr);
        }

        .gallery-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .event-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 28px;
        }

        .stat-card-alt-grid {
            grid-template-columns: 1fr 1fr !important;
        }

        .footer-grid {
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .footer-bottom {
            flex-direction: row;
            justify-content: space-between;
        }
    }


    /* ============================================================
