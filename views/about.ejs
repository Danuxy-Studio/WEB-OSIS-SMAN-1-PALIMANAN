<%- include('partials/header', {title: 'Tentang'}) %>

<!-- ===== HERO ABOUT ===== -->
<section class="about-hero">
    <div class="container">
        <div class="about-hero-content">
            <span class="about-badge"><i class="fas fa-school"></i> SMAN 1 Palimanan</span>
            <h1 class="about-title">Tentang <span class="highlight">OSIS</span></h1>
            <p class="about-subtitle">
                Organisasi Siswa Intra Sekolah yang berdedikasi untuk mengembangkan potensi,
                kreativitas, dan jiwa kepemimpinan siswa melalui program-program unggulan.
            </p>
        </div>
    </div>
</section>

<!-- ===== DESKRIPSI ===== -->
<section class="about-description">
    <div class="container">
        <div class="about-desc-card">
            <div class="about-desc-icon">
                <i class="fas fa-quote-left"></i>
            </div>
            <p>
                Terciptanya OSIS yang berperan dalam layanan aspirasi dan pengembangan ilmu pengetahuan
                yang mendukung kemampuan inovatif, berdaya saing, kreatif, dan berintegritas dengan
                memanfaatkan dukungan teknologi.
            </p>
        </div>
    </div>
</section>

<!-- ===== VISI & MISI ===== -->
<section class="about-vm">
    <div class="container">
        <div class="vm-grid">
            <!-- VISI -->
            <div class="vm-card visi-card">
                <div class="vm-icon">
                    <i class="fas fa-eye"></i>
                </div>
                <h3 class="vm-title">Visi</h3>
                <div class="vm-divider"></div>
                <p class="vm-text">
                    Terwujudnya OSIS sebagai wadah pengembangan prestasi dan pembentukan karakter
                    berdasarkan asas <strong>GLORY</strong>
                    <span class="glory-text">(Gigih, Loyal, Optimis, Religius, dan Yakin)</span>
                    untuk menciptakan budaya sekolah yang mengedepankan nilai-nilai positif.
                </p>
            </div>

            <!-- MISI -->
            <div class="vm-card misi-card">
                <div class="vm-icon">
                    <i class="fas fa-bullseye"></i>
                </div>
                <h3 class="vm-title">Misi</h3>
                <div class="vm-divider"></div>
                <ul class="misi-list">
                    <li>
                        <span class="misi-number">01</span>
                        <span class="misi-text">Meningkatkan prestasi siswa/i melalui kegiatan akademik maupun non-akademik yang mendukung minat, bakat, dan potensi melalui kegiatan di sekolah.</span>
                    </li>
                    <li>
                        <span class="misi-number">02</span>
                        <span class="misi-text">Menumbuhkan karakter mulia dengan membangun budaya disiplin, bertanggung jawab, dan rasa kepedulian terhadap lingkungan sekolah.</span>
                    </li>
                    <li>
                        <span class="misi-number">03</span>
                        <span class="misi-text">Mengembangkan program kerja OSIS yang inovatif, terstruktur, dan bermanfaat bagi seluruh masyarakat sekolah SMAN 1 Palimanan.</span>
                    </li>
                    <li>
                        <span class="misi-number">04</span>
                        <span class="misi-text">Mendorong siswa/i aktif dalam pengembangan ilmu pengetahuan melalui perlombaan dan kegiatan edukatif dengan memanfaatkan perkembangan teknologi.</span>
                    </li>
                    <li>
                        <span class="misi-number">05</span>
                        <span class="misi-text">Menyediakan wadah aspirasi siswa melalui media digital maupun forum secara langsung.</span>
                    </li>
                    <li>
                        <span class="misi-number">06</span>
                        <span class="misi-text">Memperkuat kolaborasi antar siswa/i, guru, dan seluruh elemen masyarakat sekolah SMAN 1 Palimanan dalam membangun sekolah yang unggul.</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- ===== MOTTO / TAGLINE ===== -->
<section class="about-motto">
    <div class="container">
        <div class="motto-box">
            <i class="fas fa-quote-right motto-icon"></i>
            <blockquote>
                "Bersama Satukan Langkah, Wujudkan Mimpi, Rise With Passion And SHIINEEE✨"
            </blockquote>
            <span class="motto-author">OSIS SMAN 1 Palimanan</span>
        </div>
    </div>
</section>

