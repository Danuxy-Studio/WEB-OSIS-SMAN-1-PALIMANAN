<%- include('partials/header', {title: 'Beranda'}) %>

<!-- ============================================================ -->
<!-- HERO DENGAN BACKGROUND FOTO -->
<!-- ============================================================ -->
<section class="hero hero-with-bg">
    <div class="hero-bg-overlay"></div>
    <div class="hero-bg-image"></div>
    <div class="container hero-content">
        <div class="badge">SMAN 1 Palimanan</div>
        <h1>Program Kerja <br/><span class="highlight">OSIS</span></h1>
        <p>Program kerja OSIS adalah rencana kegiatan yang disusun sebagai pedoman dalam menjalankan tugas organisasi selama satu periode kepengurusan. Program ini bertujuan untuk mengembangkan potensi, kreativitas, serta jiwa kepemimpinan siswa melalui berbagai kegiatan yang positif dan bermanfaat.</p>
    </div>
</section>

<!-- ============================================================ -->
<!-- SLIDER FOTO -->
<!-- ============================================================ -->
<section class="slider-section">
    <div class="container">
        <h2 class="section-title" style="text-align:center; margin-bottom:8px;">
            <i class="fas fa-images"></i> Galeri Kegiatan
        </h2>
        <p style="text-align:center; color:var(--text-muted); margin-bottom:24px;">
            Dokumentasi momen-momen berharga dalam setiap kegiatan OSIS.
        </p>

        <div class="slider-wrapper">
            <div class="slider-container" data-slider data-autoplay="4000">
                <div class="slider-track">
                    <% for (let i = 1; i <= 8; i++) { %>
                        <div class="slider-slide">
                            <img src="/assets/slider/foto<%= i %>.jpg" alt="Kegiatan OSIS <%= i %>" loading="lazy">
                            <div class="slide-caption"></div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="slider-dots"></div>
    </div>
</section>

<!-- ============================================================ -->
<!-- STATS -->
<!-- ============================================================ -->
<section class="stats-bg" style="padding:24px 0;">
    <div class="container">
        <div class="stats-grid">
            <div class="stat-card">
                <span class="number">5</span>
                <span class="label"><i class="fas fa-calendar-check"></i> Event Unggulan</span>
            </div>
            <div class="stat-card">
                <span class="number">10+</span>
                <span class="label"><i class="fas fa-trophy"></i> Bidang Lomba</span>
            </div>
            <div class="stat-card">
                <span class="number">1000+</span>
                <span class="label"><i class="fas fa-users"></i> Peserta</span>
            </div>
            <div class="stat-card">
                <span class="number">1</span>
                <span class="label"><i class="fas fa-clock"></i> Periode</span>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================ -->
<!-- CARD CUPLIKAN EVENT (data-driven, dikirim dari server.js) -->
<!-- ============================================================ -->
<section style="padding:32px 0;">
    <div class="container">
        <h2 class="section-title" style="text-align:center; margin-bottom:8px;">
            <i class="fas fa-star"></i> Event Unggulan
        </h2>
        <p style="text-align:center; color:var(--text-muted); margin-bottom:24px;">
            Event unggulan merupakan kegiatan berskala besar yang menjadi program utama OSIS. Klik card untuk melihat detail lengkap.
        </p>

        <div class="event-grid">
            <% events.forEach(function (e) { %>
                <a href="/event/<%= e.id %>" class="event-card-link">
                    <div class="event-card">
                        <div style="display:flex; justify-content:center; margin:0 auto 12px;">
                            <img src="<%= e.logo %>" alt="<%= e.title %>" loading="lazy" style="width:200px; height:200px; object-fit:contain;">
                        </div>
                        <p style="text-align:center; font-size:0.9rem;"><%= e.shortDesc || e.description %></p>
                        <span class="tag" style="display:table; margin:8px auto;"><i class="fas fa-tag"></i> <%= e.category %></span>
                        <div style="text-align:center; margin-top:8px;">
                            <span class="btn-primary" style="display:inline-block; padding:6px 20px; font-size:0.85rem;">
                                <i class="fas fa-arrow-right"></i> Detail
                            </span>
                        </div>
                    </div>
                </a>
            <% }); %>
        </div>

        <div style="text-align:center; margin-top:24px;">
            <a href="/events" class="btn-primary"><i class="fas fa-list"></i> Lihat Semua Event</a>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
