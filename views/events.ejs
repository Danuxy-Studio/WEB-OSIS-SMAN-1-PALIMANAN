<%- include('partials/header', {title: 'Event'}) %>

<section style="padding:24px 0;">
    <div class="container">
        <h2 class="section-title"><i class="fas fa-list"></i> Semua Event</h2>
        <p class="section-sub">Klik card event untuk melihat detail lengkap.</p>

        <form method="GET" action="/events" style="display:flex; flex-direction:column; gap:10px; margin-bottom:24px;">
            <input type="text" name="search" placeholder="Cari event..." value="<%= search %>" style="padding:12px 16px; border-radius:30px; border:1px solid var(--border-color); font-size:1rem; background:var(--bg-card); color:var(--text-primary);">
            <div style="display:flex; gap:10px; flex-wrap:wrap;">
                <select name="category" style="flex:1; padding:12px 16px; border-radius:30px; border:1px solid var(--border-color); font-size:1rem; background:var(--bg-card); color:var(--text-primary);">
                    <option value="">Semua Kategori</option>
                    <% categories.forEach(c => { %>
                        <option value="<%= c %>" <%= category === c ? 'selected' : '' %>><%= c %></option>
                    <% }) %>
                </select>
                <button type="submit" class="btn-primary" style="flex:1;"><i class="fas fa-filter"></i> Filter</button>
                <a href="/events" class="btn-primary btn-secondary" style="flex:1; text-align:center;"><i class="fas fa-undo"></i> Reset</a>
            </div>
        </form>

        <div class="event-grid">
            <% if (events && events.length > 0) { %>
                <% events.forEach(e => { %>
                    <a href="/event/<%= e.id %>" class="event-card-link">
                        <div class="event-card">
                            <div style="display:flex; justify-content:center; margin:0 auto 12px;">
                                <img src="<%= e.logo || 'https://picsum.photos/seed/default/200/200' %>" alt="<%= e.title %>" loading="lazy" style="width:200px; height:200px; object-fit:contain;">
                            </div>
                            <p style="text-align:center;"><%= e.shortDesc || e.description %></p>
                            <span class="tag" style="display:table; margin:8px auto;"><i class="fas fa-tag"></i> <%= e.category || 'Umum' %></span>
                            <div style="text-align:center; margin-top:8px;">
                                <span class="btn-primary" style="display:inline-block; padding:6px 20px; font-size:0.85rem;">
                                    <i class="fas fa-arrow-right"></i> Detail
                                </span>
                            </div>
                        </div>
                    </a>
                <% }) %>
            <% } else { %>
                <p>Tidak ada event yang cocok.</p>
            <% } %>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
