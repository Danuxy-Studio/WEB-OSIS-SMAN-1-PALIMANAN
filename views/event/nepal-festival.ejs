<!-- ===== SLIDER SCRIPT NEPAL FESTIVAL (AUTO-SLIDE) ===== -->
<script>
    (function() {
        const track = document.getElementById('sliderNepalTrack');
        const dots = document.querySelectorAll('#sliderNepalDots .dot');
        let currentIndex = 0;
        const totalSlides = 3;
        let autoPlayInterval;

        if (!track || dots.length === 0) return;

        function goToSlide(index) {
            if (index < 0) index = totalSlides - 1;
            if (index >= totalSlides) index = 0;
            currentIndex = index;
            track.style.transform = 'translateX(-' + (currentIndex * 100) + '%)';
            dots.forEach((dot, i) => {
                dot.classList.toggle('active', i === currentIndex);
            });
        }

        function nextSlide() {
            goToSlide(currentIndex + 1);
        }

        function startAutoPlay() {
            autoPlayInterval = setInterval(nextSlide, 4000);
        }

        function stopAutoPlay() {
            clearInterval(autoPlayInterval);
        }

        dots.forEach(function(dot) {
            dot.addEventListener('click', function() {
                stopAutoPlay();
                const index = parseInt(this.getAttribute('data-index'));
                goToSlide(index);
                startAutoPlay();
            });
        });

        const container = document.getElementById('sliderNepalContainer');
        if (container) {
            container.addEventListener('mouseenter', stopAutoPlay);
            container.addEventListener('mouseleave', startAutoPlay);
        }

        let touchStartX = 0;
        let touchEndX = 0;

        if (container) {
            container.addEventListener('touchstart', function(e) {
                touchStartX = e.changedTouches[0].screenX;
            }, { passive: true });

            container.addEventListener('touchend', function(e) {
                touchEndX = e.changedTouches[0].screenX;
                const diff = touchStartX - touchEndX;
                if (Math.abs(diff) > 50) {
                    stopAutoPlay();
                    if (diff > 0) {
                        goToSlide(currentIndex + 1);
                    } else {
                        goToSlide(currentIndex - 1);
                    }
                    startAutoPlay();
                }
            }, { passive: true });
        }

        startAutoPlay();
    })();
</script>