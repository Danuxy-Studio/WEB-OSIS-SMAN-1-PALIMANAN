<%- include('../partials/header', {title: event.title}) %>

<section style="padding:24px 0;">
    <div class="container">
        <a href="/events" class="btn-primary btn-secondary" style="display:inline-block; margin-bottom:16px;">
            <i class="fas fa-arrow-left"></i> Kembali ke Daftar Event
        </a>

        <!-- TAMPILKAN KONTEN EVENT SESUAI ID -->
        <% if (event.id === 1) { %>
            <%- include('gema-sastra') %>
        <% } else if (event.id === 2) { %>
            <%- include('nepal-festival') %>
        <% } else if (event.id === 3) { %>
            <%- include('porak') %>
        <% } else if (event.id === 4) { %>
            <%- include('mpls') %>
        <% } else if (event.id === 5) { %>
            <%- include('diklat') %>
        <% } else { %>
            <div class="event-detail-full">
                <div style="display:flex; justify-content:center; margin-bottom:16px;">
                    <i class="fas fa-calendar-alt" style="font-size:4rem; color:var(--brand-blue-accent);"></i>
                </div>
                <img src="<%= event.image || 'https://picsum.photos/seed/detail/800/400' %>" alt="<%= event.title %>" style="width:100%; border-radius:16px; margin:16px 0; max-height:300px; object-fit:cover;">
                <p><i class="fas fa-tag"></i> <strong>Kategori:</strong> <%= event.category || 'Umum' %></p>
                <p><i class="fas fa-calendar-day"></i> <strong>Tanggal:</strong> <%= event.date || 'TBA' %></p>
                <p><i class="fas fa-map-marker-alt"></i> <strong>Lokasi:</strong> <%= event.location || 'Belum ditentukan' %></p>
                <p style="margin-top:16px;"><%= event.description %></p>
            </div>
        <% } %>
    </div>
</section>

<%- include('../partials/footer') %>
